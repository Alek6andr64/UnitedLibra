/* ===================================================
   SIDEBAR (из sidebar.cpp)
   =================================================== */

Sidebar {
    background-color: #f8f9fa;
    border-right: 1px solid #dee2e6;
}

/* Заголовок */
Sidebar QWidget#headerWidget {
    background-color: #ffffff;
    border-bottom: 1px solid #dee2e6;
}

Sidebar QLabel#titleLabel {
    color: #212529;
    font-size: 18px;
    font-weight: bold;
    background-color: transparent;
    border: none;
}

Sidebar QLabel#versionLabel {
    color: #6c757d;
    font-size: 10px;
    background-color: transparent;
    border: none;
}

/* Скролл область */
Sidebar QScrollArea {
    background-color: #f8f9fa;
    border: none;
}

Sidebar QScrollBar:vertical {
    background-color: #f8f9fa;
    width: 6px;
    margin: 0px;
}

Sidebar QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 3px;
}

Sidebar QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

Sidebar QScrollBar::add-line:vertical,
Sidebar QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Заголовки секций */
Sidebar QLabel.sectionTitle {
    color: #6c757d;
    font-size: 11px;
    font-weight: 600;
    padding: 8px 12px 4px 12px;
    background-color: transparent;
    border: none;
    letter-spacing: 0.5px;
}

/* Кнопки меню */
Sidebar QPushButton.navButton {
    text-align: left;
    padding: 8px 12px;
    padding-left: 40px;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: normal;
    color: #495057;
    background-color: transparent;
}

Sidebar QPushButton.navButton:hover {
    background-color: #e9ecef;
    color: #212529;
}

Sidebar QPushButton.navButton:pressed {
    background-color: #dee2e6;
}

/* Выделенная кнопка (динамическое свойство selected) */
Sidebar QPushButton.navButton[selected="true"] {
    color: #0d6efd;
    background-color: #e7f1ff;
    font-weight: 600;
}

/* Разделитель */
Sidebar QFrame.separator {
    background-color: #dee2e6;
    max-height: 1px;
}

/* Панель аккаунта */
Sidebar QWidget.accountPanel {
    background-color: #ffffff;
    border-top: 1px solid #dee2e6;
}

Sidebar QLabel.avatarLabel {
    background-color: #e9ecef;
    border-radius: 20px;
    font-size: 22px;
}

Sidebar QLabel.nameLabel {
    color: #212529;
    font-size: 13px;
    font-weight: 600;
    background-color: transparent;
    border: none;
}

Sidebar QLabel.roleLabel {
    color: #6c757d;
    font-size: 10px;
    background-color: transparent;
    border: none;
}

/* ===================================================
   DATAEDITING (из dataediting.cpp)
   =================================================== */

DataEditing QGroupBox {
    font-weight: bold;
    border: 2px solid #cccccc;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
}

DataEditing QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
}

DataEditing QLineEdit,
DataEditing QSpinBox,
DataEditing QComboBox {
    padding: 5px;
    border: 1px solid #cccccc;
    border-radius: 4px;
    min-height: 25px;
}

DataEditing QPushButton {
    padding: 8px 15px;
    border: none;
    border-radius: 5px;
    font-weight: bold;
}

DataEditing QPushButton#saveBtn {
    background-color: #4CAF50;
    color: white;
}

DataEditing QPushButton#saveBtn:hover {
    background-color: #45a049;
}

DataEditing QPushButton#cancelBtn {
    background-color: #f44336;
    color: white;
}

DataEditing QPushButton#cancelBtn:hover {
    background-color: #da190b;
}

/* ===================================================
   AUTHDIALOG (из authdialog.cpp)
   =================================================== */

AuthDialog {
    background-color: #ffffff;
}

AuthDialog QLabel {
    color: #212529;
    font-size: 13px;
}

AuthDialog QLineEdit {
    padding: 8px 12px;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    font-size: 13px;
    background-color: #ffffff;
}

AuthDialog QLineEdit:focus {
    border-color: #0d6efd;
    outline: none;
}

AuthDialog QPushButton {
    padding: 8px 16px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
}

AuthDialog QPushButton[flat="true"] {
    background-color: transparent;
    color: #0d6efd;
}

AuthDialog QPushButton[flat="true"]:hover {
    color: #0a58ca;
}

/* Заголовок UnitedLibra */
AuthDialog QLabel[mainTitle="true"] {
    font-size: 26px;
    font-weight: bold;
    color: #0d6efd;
    background-color: #f8f9fa;
    border-bottom: 1px solid #dee2e6;
}

/* Заголовки страниц */
AuthDialog QLabel[pageTitle="login"],
AuthDialog QLabel[pageTitle="register"] {
    font-size: 22px;
    font-weight: bold;
    color: #212529;
}

AuthDialog QLabel[pageTitle="code"] {
    font-size: 18px;
    font-weight: bold;
    color: #212529;
}

/* Кнопки входа/регистрации */
AuthDialog QPushButton[actionBtn="true"] {
    background-color: #0d6efd;
    color: white;
    font-weight: bold;
}

AuthDialog QPushButton[actionBtn="true"]:hover {
    background-color: #0b5ed7;
}

/* Ссылки */
AuthDialog QPushButton[linkBtn="true"] {
    color: #0d6efd;
    font-size: 13px;
    font-weight: 500;
}

AuthDialog QPushButton[linkBtn="true"]:hover {
    text-decoration: underline;
}

/* Кнопка "Вернуться" */
AuthDialog QPushButton[backBtn="true"] {
    color: #6c757d;
    font-size: 13px;
    text-align: left;
}

AuthDialog QPushButton[backBtn="true"]:hover {
    color: #0d6efd;
}

/* ===================================================
   TAGEDITOR (из tageditor.cpp)
   =================================================== */

/* Стили для тегов (Tag) */
Tag #tagWidget {
    border: 1px solid #4a90e2;
    border-radius: 6px;
    background: #4a90e2;
}

Tag #tagWidget:hover {
    background: #357abd;
    border-color: #357abd;
}

Tag #tagLabel {
    color: white;
}

Tag #tagCloseBtn {
    background: transparent;
    color: white;
    font-weight: bold;
    border: none;
}

Tag #tagCloseBtn:hover {
    color: #413F3F;
}

/* Контейнер TagEditor */
TagEditor #authorsContainer {
    border: 1px solid #ccc;
    border-radius: 4px;
    background: white;
}

TagEditor #authorsContainer:focus-within {
    border-color: #66afe9;
    outline: none;
}

TagEditor #tagLineEdit {
    border: none;
    padding: 4px;
    background: transparent;
}

TagEditor #tagLineEdit:focus {
    outline: none;
}